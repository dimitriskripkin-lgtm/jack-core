#!/usr/bin/env python3
MODULE_VERSION = 1
import os, json, urllib.request, sys
H = "/data/data/com.termux/files/home/jack"
LOG = H + "/read_curl.log"
URL = "https://raw.githubusercontent.com/ollama/ollama/main/README.md"

def log(m):
    print(m, flush=True)
    open(LOG, "a").write(m + "\n")

def fetch(url, n=12000):
    req = urllib.request.Request(url, headers={"User-Agent": "JACK/1.0"})
    with urllib.request.urlopen(req, timeout=25) as r:
        return r.read()[:n].decode("utf-8", "replace")

def ask(text):
    sys.path.insert(0, H)
    try:
        import jack_groq_bridge as groq
        return groq.ask_groq(
            "Du bist JACK. Fasse in 8-12 kurzen deutschen Saetzen zusammen, "
            "was Ollama ist und wie man es nutzt. Nur aus dem Text. Keine Floskeln.",
            text[:8000],
            timeout=40,
        )
    except Exception as e:
        return "Groq fail: %s" % e

def main():
    log("=== CURL READ ===")
    log("URL " + URL)
    body = fetch(URL)
    log("BYTES %d" % len(body))
    log("--- ANFANG ---")
    log(body[:500].replace("\n", " | "))
    log("--- ZUSAMMENFASSUNG ---")
    sum_ = ask(body)
    log(sum_)
    open(H + "/learned_ollama_readme.txt", "w").write(sum_ + "\n\n---\n" + body[:4000])
    log("SAVED learned_ollama_readme.txt")
    log("=== ENDE ===")

if __name__ == "__main__":
    main()
