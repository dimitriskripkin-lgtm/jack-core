#!/usr/bin/env python3
MODULE_VERSION = 1
"""Offene Fehler aus jack_errors.db. Read-only, keine Nebenwirkungen."""
import os, sqlite3
DB = os.path.expanduser("~/jack/jack_errors.db")
def main():
    if not os.path.isfile(DB):
        print("Fehlerdatenbank nicht gefunden"); return
    con = sqlite3.connect(DB)
    try:
        n = con.execute("SELECT COUNT(*) FROM errors WHERE resolved=0").fetchone()[0]
        if not n:
            print("Keine offenen Fehler."); return
        print("Offene Fehler: " + str(n))
        for r in con.execute("SELECT timestamp,module,error_msg FROM errors "
                             "WHERE resolved=0 ORDER BY id DESC LIMIT 5"):
            print("  [" + str(r[0])[:16] + "] " + str(r[1]) + ": " + str(r[2])[:70])
    finally:
        con.close()
if __name__ == "__main__":
    main()
