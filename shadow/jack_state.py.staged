#!/usr/bin/env python3
MODULE_VERSION = 1
"""JACK State Machine: erkennt Schichtstart, Fahrtmodus, Feierabend anhand Zeit+Kontext."""
import os,json,datetime

STATE_FILE=os.path.expanduser("~/jack/.jack_state.json")

STATES={
    "NACHTSCHICHT":  {"start":22,"end":10},
    "POWER_TIME":    {"start":8,"end":15},
    "SCHLAF":        {"start":16,"end":22},
}

def _now_hour():
    return datetime.datetime.now().hour

def detect_state():
    h=_now_hour()
    if 22<=h or h<10:  return "NACHTSCHICHT"
    if 8<=h<15:        return "POWER_TIME"
    if 16<=h<22:       return "SCHLAF"
    return "UEBERGANG"

def get_context_for_gemini():
    """Gibt State-Kontext fuer Gemini-System-Prompt zurueck."""
    state=detect_state()
    h=_now_hour()
    hints={
        "NACHTSCHICHT": "Dima ist gerade auf Tour (Nachtschicht). Kurze Antworten, er faehrt. Keine langen Erklaerungen.",
        "POWER_TIME":   "Dima hat Programmierzeit (08-15 Uhr). Volle technische Antworten erlaubt.",
        "SCHLAF":       "Dima schlaeft wahrscheinlich (16-22 Uhr). Nur bei explizitem Aufruf antworten.",
        "UEBERGANG":    "Uebergangszeit. Normaler Ton.",
    }
    return {"state":state,"hour":h,"hint":hints.get(state,"")}

def save_state(extra=None):
    ctx=get_context_for_gemini()
    if extra: ctx.update(extra)
    ctx["timestamp"]=datetime.datetime.now().isoformat()
    try: open(STATE_FILE,"w").write(json.dumps(ctx,ensure_ascii=False))
    except Exception: pass
    return ctx

def load_state():
    try: return json.load(open(STATE_FILE))
    except Exception: return get_context_for_gemini()

if __name__=="__main__":
    ctx=save_state()
    print(json.dumps(ctx,indent=2,ensure_ascii=False))
